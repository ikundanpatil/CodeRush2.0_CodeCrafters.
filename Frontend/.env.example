# Copy to `.env` for local overrides (optional -- the app works with no
# .env at all, defaulting to http://localhost:8000/api for local dev).
# In Vercel, set this in Project Settings -> Environment Variables to your
# deployed Railway backend URL, e.g.:
#   VITE_API_BASE_URL=https://your-backend.up.railway.app/api
VITE_API_BASE_URL=http://localhost:8000/api
