# =============================================================================
# EvoResearch - Environment Variables
# Copy to `.env` and fill in real values. NEVER commit secrets.
# The application reads these at startup. If MySQL/Chroma are not configured
# here, the memory system runs in a degraded in-memory fallback so that
# research continues to work (useful for tests / demos).
# =============================================================================

# ---- MySQL (structured memory, source of truth) ----------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=eversoresearch

# ---- ChromaDB (semantic / vector memory index) ------------------------------
# Leave CHROMA_PERSIST_DIR empty to use an in-memory Chroma client.
CHROMA_PERSIST_DIR=./chroma_data
# Chroma collection name (defaults to evoresearch_memories)
CHROMA_COLLECTION=eversoresearch_memories

# ---- Embeddings -------------------------------------------------------------
# Provider for EmbeddingService: "local" (deterministic hash embedder, offline)
# or "openai" (requires OPENAI_API_KEY).
EVORESEARCH_EMBEDDING_PROVIDER=local
OPENAI_API_KEY=

# ---- LLM Adapter (Phase 1) --------------------------------------------------
# "mock" (default; deterministic, offline, used for tests) | "openai" | "nvidia"
LLM_PROVIDER=mock
# Model name passed to the chosen provider, e.g. gpt-4.1-mini or
# nvidia/nemotron-3-nano-30b-a3b. Leave empty to use the provider's default.
LLM_MODEL=
# Required when LLM_PROVIDER=openai (reuses OPENAI_API_KEY above).
# Required when LLM_PROVIDER=nvidia:
NVIDIA_API_KEY=

# ---- Search Provider (Phase 2) ----------------------------------------------
# "mock" (default; deterministic, offline, used for tests) | "tavily"
SEARCH_PROVIDER=mock
# Required when SEARCH_PROVIDER=tavily:
TAVILY_API_KEY=

# ---- Sandbox (Phase 5) -------------------------------------------------------
# Master switch. When false, sandbox execution is disabled entirely and the
# mock provider (which performs no real execution) is always used.
SANDBOX_ENABLED=true
# "mock" (default; deterministic, offline, used for tests, does not execute
# anything) | "docker" (requires the Docker CLI on PATH).
SANDBOX_PROVIDER=mock
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_OUTPUT_LIMIT=65536

# ---- Research Quality Validator (Phase 5) ------------------------------------
# Minimum reliable evidence a run must collect before it is flagged valid
# (errors, not automatically fatal -- the orchestrator still completes and
# reports the run, just with quality.valid=false and reasons attached).
MIN_SOURCES=3
MIN_EVIDENCE=3
MIN_SUPPORTED_CLAIMS=1

# ---- Autonomous Research Loop (Phase 6) --------------------------------------
# Hard cap on research iterations. The loop always stops here even if quality
# requirements are still unmet -- never allow unbounded autonomous searching.
MAX_RESEARCH_ITERATIONS=3

# ---- Safety + Policy Engine (Phase 8) ----------------------------------------
# Deterministic policy layer that governs what research/self-evolution may
# do. Security-critical DENY rules (MODIFY_CODE, MODIFY_SECURITY,
# MODIFY_POLICY, ACCESS_SECRET, EXECUTE_HOST_COMMAND) and the evolution
# safety-limit checks below are always enforced -- this flag only controls
# whether the engine reports itself ACTIVE and whether the always-ALLOW
# research-action checks (search/browse/etc.) run at all.
POLICY_ENGINE_ENABLED=true
# Hard ceilings an evolved strategy can never exceed. Reuses the same
# defaults as the Phase 5 quality validator / Phase 6 research loop above --
# an evolved strategy can operate below these, never above them.
MAX_ALLOWED_RESEARCH_ITERATIONS=3
MAX_ALLOWED_RESULTS_PER_QUERY=20
MAX_ALLOWED_SOURCES_PER_ITERATION=20
MAX_ALLOWED_SANDBOX_TIMEOUT=30
MAX_ALLOWED_SANDBOX_MEMORY=256m
MAX_ALLOWED_SANDBOX_CPU=0.5

# ---- FastAPI / server -------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173